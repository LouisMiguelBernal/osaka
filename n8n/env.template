# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OSAKA_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Must equal OSAKA_INGEST_SECRET in app/.env.local
OSAKA_INGEST_SECRET=
# Where failure/quarantine alerts go (you)
OSAKA_OPERATOR_EMAIL=
# The Gmail address n8n is connected to (replies from it are ignored to prevent loops)
OSAKA_BOT_EMAIL=
# Google Drive folder ID that holds OSAKA/<client>/<type>/ (restricted sharing)
OSAKA_DRIVE_ROOT_FOLDER_ID=
# Google Sheet ID with tabs: intake, tax_return, financial_statement
OSAKA_SHEET_ID=
OSAKA_BASE_URL=http://host.docker.internal:3030
TZ=Asia/Manila
