    {
      "id": "c49b422d-dc0c-0a48-f47c-f6e55d819184",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Gmail's addLabels needs label IDs; resolve them once per run by name.\nconst byName = Object.fromEntries($('Get labels').all().map((l) => [l.json.name, l.json.id]));\nconst labelIds = { processed: byName['OSAKA/Processed'], failed: byName['OSAKA/Failed'], quarantine: byName['OSAKA/Quarantine'] };\nconst missing = Object.entries(labelIds).filter(([, v]) => !v).map(([k]) => k);\nif (missing.length) throw new Error('Create these Gmail labels first: ' + missing.map((m) => 'OSAKA/' + m[0].toUpperCase() + m.slice(1)).join(', '));\nreturn $('Prepare PDFs').all().map((it) => ({ json: { ...it.json, labelIds }, binary: it.binary }));"
      },
      "name": "Label map + items",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        300
      ]
