      "id": "4dd819ea-161c-1155-4c40-95601c27915a",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const senderOf = (fileName) => {\n  const m = /^([^\\s_]+@[^\\s_]+\\.[a-z]{2,})__(.+)$/i.exec(fileName);\n  return (m ? m[1] : ($env.OSAKA_LOCAL_SENDER || 'local-drop@osaka.local')).toLowerCase();\n};\nconst out = [];\nfor (const it of $input.all()) {\n  const p = String(it.json.path || '');\n  const fileName = p.split('/').pop();\n  if (!/\\.pdf$/i.test(fileName)) continue;\n  out.push({ json: { path: p, fileName, senderEmail: senderOf(fileName), via: 'watch' } });\n}\nreturn out;"
      },
      "name": "Only PDFs",
      "type": "n8n-nodes-base.code",
      "position": [
        220,
        0
      ]
    },
