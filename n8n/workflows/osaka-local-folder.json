    {
      "id": "85a61b7a-132d-6f0a-8701-9c1b61266525",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst sign = (parts) => {\n  const ts = String(Math.floor(Date.now() / 1000));\n  const sig = crypto.createHmac('sha256', $env.OSAKA_INGEST_SECRET).update(['v1', ts, ...parts].join('\\n')).digest('hex');\n  return { ts, signature: 'sha256=' + sig };\n};\n// Signed immediately before sending (±300 s window), one file at a time.\nconst src = $input.first().json;\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'file');\nconst sha = crypto.createHash('sha256').update(buf).digest('hex');\nconst messageId = 'local:' + sha;\nreturn [{ json: { ...src, messageId, senderAuth: 'pass', ...sign([messageId, sha, src.senderEmail, 'pass', 'local']) }, binary: $input.first().binary }];"
      },
      "name": "Sign request (local)",
      "type": "n8n-nodes-base.code",
      "position": [
        1320,
        120
      ]
    },
