# OSAKA app configuration. `npm run setup:env` copies this to .env.local and fills in generated secrets.

APP_URL=http://localhost:3030

# Postgres from ../n8n/docker-compose.yml
DATABASE_URL=

# 64-char hex. Encrypts SSN/EIN at rest and signs file links. Losing it makes encrypted fields unreadable.
FIELD_ENCRYPTION_KEY=
# Shared with n8n (OSAKA_INGEST_SECRET in ../n8n/.env). Authenticates every ingest request.
OSAKA_INGEST_SECRET=

# Where received PDFs are stored
STORAGE_DIR=./storage

# Local model (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Email intake: sender domains (yourcompany.com) or addresses accepted besides known clients. Empty = known clients only.
OSAKA_SENDER_ALLOWLIST=
# Require an SPF/DKIM/DMARC pass (reported by n8n from Authentication-Results). 1 = on.
OSAKA_REQUIRE_SENDER_AUTH=1

# Optional: protect the dashboard with HTTP basic auth (recommended if you ever bind beyond localhost)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
