{
  "name": "osaka-app",
  "version": "1.0.0",
  "private": true,
  "description": "OSAKA: local-first document intake. PDFs in, a local LLM extracts structured fields, humans review.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3030",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3030",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "1.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.41",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
